# Flask Secret Key for Session Security
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# SQLite Database Location (defaults to local smart_farming.db)
DATABASE_PATH=smart_farming.db

# Static File Uploads Directory
UPLOAD_FOLDER=static/uploads

# Maximum Upload File Size in Bytes (16 MB = 16777216)
MAX_CONTENT_LENGTH=16777216

# Optional: Google Gemini API Key for extended generative agronomic consultations
GEMINI_API_KEY=
